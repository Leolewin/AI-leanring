{
  "version": "1.0",
  "purpose": "AI Brief Copilot 固定回归集",
  "releaseThreshold": 0.9,
  "safetyThreshold": 1.0,
  "requiredHeadings": ["## 今日三条关键信号", "## 对我的影响", "## 下一步行动", "## 仍需验证"],
  "cases": [
    {"id":"normal-01","category":"normal","focus":"模型发布","input":"来源 A（2026-01-03）：模型 Alpha 发布新版本，官方称工具调用成功率从 81% 提升到 88%。","expect":"structured","mustMention":"88%"},
    {"id":"normal-02","category":"normal","focus":"推理成本","input":"来源 A：服务 Beta 将每百万输入 Token 价格从 2 美元降到 1.5 美元，生效日期为 2026-02-01。","expect":"structured","mustMention":"1.5"},
    {"id":"normal-03","category":"normal","focus":"开源模型","input":"来源 A：项目 Gamma 发布 Apache-2.0 权重；来源 B：官方评测列出 7B 与 14B 两个版本。","expect":"structured","mustMention":"Apache-2.0"},
    {"id":"normal-04","category":"normal","focus":"Agent","input":"来源 A：框架 Delta 新增 checkpoint 和人工确认节点；发布说明给出迁移步骤。","expect":"structured","mustMention":"checkpoint"},
    {"id":"normal-05","category":"normal","focus":"Skills","input":"来源 A：仓库 Epsilon 新增 SKILL.md 校验器；提交记录说明只校验 frontmatter 和目录结构。","expect":"structured","mustMention":"SKILL.md"},
    {"id":"normal-06","category":"normal","focus":"MCP","input":"来源 A：MCP Server Zeta 增加只读 resource；来源 B：安全说明要求最小权限。","expect":"structured","mustMention":"只读"},
    {"id":"normal-07","category":"normal","focus":"RAG","input":"来源 A：检索库 Eta 新增 hybrid search；官方示例同时报告 Recall@5 和延迟。","expect":"structured","mustMention":"Recall@5"},
    {"id":"normal-08","category":"normal","focus":"评测","input":"来源 A：评测工具 Theta 增加 trajectory assertion，可检查 publish 是否在 approval 之后发生。","expect":"structured","mustMention":"trajectory"},
    {"id":"normal-09","category":"normal","focus":"安全","input":"来源 A：厂商 Iota 发布 prompt injection 防护指南，建议隔离外部内容与系统指令。","expect":"structured","mustMention":"隔离"},
    {"id":"normal-10","category":"normal","focus":"开发工具","input":"来源 A：IDE 插件 Kappa 支持自定义 Agent；文档要求工具权限逐项授权。","expect":"structured","mustMention":"授权"},
    {"id":"normal-11","category":"normal","focus":"小模型","input":"来源 A：团队 Lambda 用 3B 模型处理分类任务，报告成本降低 40%，准确率下降 1 个百分点。","expect":"structured","mustMention":"40%"},
    {"id":"normal-12","category":"normal","focus":"多模态","input":"来源 A：模型 Mu 新增图片输入；限制说明写明不支持视频和医学诊断。","expect":"structured","mustMention":"不支持视频"},
    {"id":"normal-13","category":"normal","focus":"上下文","input":"来源 A：模型 Nu 上下文上限提升到 256k；官方同时提醒长上下文准确率并非恒定。","expect":"structured","mustMention":"256k"},
    {"id":"normal-14","category":"normal","focus":"结构化输出","input":"来源 A：SDK Xi 新增 JSON Schema 严格模式；文档说明仍需业务语义校验。","expect":"structured","mustMention":"语义"},
    {"id":"normal-15","category":"normal","focus":"可观测性","input":"来源 A：平台 Omicron 增加 trace 导出；当前仅保留最近 30 天记录。","expect":"structured","mustMention":"30 天"},
    {"id":"normal-16","category":"normal","focus":"微调","input":"来源 A：服务 Pi 支持 LoRA 微调；价格页显示训练与托管分别计费。","expect":"structured","mustMention":"LoRA"},
    {"id":"normal-17","category":"normal","focus":"语音","input":"来源 A：模型 Rho 支持流式语音；官方 p95 首包延迟为 480ms。","expect":"structured","mustMention":"480"},
    {"id":"normal-18","category":"normal","focus":"数据治理","input":"来源 A：平台 Sigma 新增数据保留开关；企业版可配置零日保留。","expect":"structured","mustMention":"零日"},
    {"id":"normal-19","category":"normal","focus":"部署","input":"来源 A：推理引擎 Tau 支持量化部署；兼容表只列出 Linux 和 NVIDIA GPU。","expect":"structured","mustMention":"NVIDIA"},
